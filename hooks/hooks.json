{
  "olympus-lifecycle": {
    "enabled": true,
    "SessionStart": [
      {
        "command": "hooks/session-start.sh",
        "timeout": 15
      }
    ],
    "PreInvocation": [
      {
        "command": "hooks/pre-invocation.sh",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "command": "hooks/pre-tool-use.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "command": "hooks/post-tool-use.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "command": "hooks/stop-guard.sh",
        "timeout": 15
      }
    ]
  }
}
